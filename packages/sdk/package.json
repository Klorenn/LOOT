{
  "name": "loot",
  "version": "0.2.0",
  "description": "Loot SDK — create, read, claim and close one-contract-per-chest puzzle chests on Stellar (XLM, Groth16 ZK proofs).",
  "type": "module",
  "license": "MIT",
  "author": "Loot",
  "repository": {
    "type": "git",
    "url": "https://github.com/Klorenn/LOOT",
    "directory": "packages/sdk"
  },
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "groth16",
    "loot",
    "xlm"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "e2e": "tsx scripts/e2e.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.3.0",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/snarkjs": "^0.7.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
