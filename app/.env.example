# Fee payer for claims + local passkey deploy channel (always needed)
RELAYER_SECRET=S...
CREATOR_SECRET=S...

# OpenZeppelin Channels (optional — preferred if you have a key)
# Without it, /api/passkey/send rebuilds {func,auth} with RELAYER_SECRET
# (handles Protocol 29 rent > uint32 via fee-bump).
# Generate at https://channels.openzeppelin.com/testnet/gen
RELAYER_BASE_URL=https://channels.openzeppelin.com/testnet
RELAYER_API_KEY=

# Guards POST /api/create-chest and /api/chests/[id]/close (x-admin-key header). Unset = always 403.
ADMIN_KEY=

# --- Networks ---
# findloot.xyz serves BOTH networks. The visitor picks one with the Testnet/Mainnet switch (cookie `loot_net`,
# testnet by default; `?net=mainnet` in a shared link sets it). NEXT_PUBLIC_STELLAR_NETWORK only changes the default.
# Testnet needs nothing. Mainnet is enabled when ALL of these are set (else the switch shows "Mainnet (coming soon)"):
# MAINNET_REGISTRY_ID=C...            # deployments/registry-mainnet.json .registry
# MAINNET_VERIFIER_ID=C...            # post-ceremony verifier
# MAINNET_RPC_URL=https://<your-mainnet-soroban-rpc>   # primary; mainnet.sorobanrpc.com is the built-in fallback
#                                     # (sent to browsers: use a domain-restricted key)
# MAINNET_HORIZON_URL=                # optional (default https://horizon.stellar.org)
# MAINNET_SAMPLE_CHEST_ID=1           # chest the "open a chest" links point to on mainnet
# MAINNET_MAX_PRIZE_PER_PLACE_XLM=1   # beta caps enforced in /create (per claim / total per chest)
# MAINNET_MAX_TOTAL_PRIZE_XLM=30

# --- Relayer secrets, one set PER network (never falls back from one to the other) ---
# RELAYER_SECRET=S...                 # testnet (above)
# RELAYER_SECRET_MAINNET=S...         # mainnet relayer account
# RELAYER_ACCOUNT_MAINNET=G...        # only if using OZ Channels (balance check needs the public key)
# RELAYER_API_KEY_MAINNET= RELAYER_BASE_URL_MAINNET=   # OZ Channels for mainnet (optional)
# RELAYER_MIN_XLM=3                   # mainnet: stop sponsoring below this balance
# RELAY_MAX_REGISTRATIONS=60          # mainnet: max sponsored passkey wallet deploys (Blob counter relay/mainnet/…)
# RELAY_MAX_FEE_STROOPS_MAINNET=      # max fee of the final tx; default 20000000 (2 XLM)
# RELAY_MAX_FEE_STROOPS=              # testnet cap (default 6000000000)
# RELAY_RATE_PER_IP_PER_MIN=10
# RELAY_RATE_GLOBAL_PER_MIN=120
