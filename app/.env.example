# Fee payer for claims + local passkey deploy channel (always needed)
RELAYER_SECRET=S...
CREATOR_SECRET=S...

# OpenZeppelin Channels (optional — preferred if you have a key)
# Without it, /api/passkey/send rebuilds {func,auth} with RELAYER_SECRET
# (handles Protocol 29 rent > uint32 via fee-bump).
# Generate at https://channels.openzeppelin.com/testnet/gen
RELAYER_BASE_URL=https://channels.openzeppelin.com/testnet
RELAYER_API_KEY=

# Guards POST /api/create-chest and /api/chests/[id]/close (x-admin-key header). Unset = always 403.
ADMIN_KEY=

# --- Network (testnet is the default) ---
# NEXT_PUBLIC_STELLAR_NETWORK=testnet | mainnet   (inlined at build)
# Mainnet requires ALL of these, otherwise the app shows a red "configuration incomplete" banner:
# NEXT_PUBLIC_STELLAR_NETWORK=mainnet
# NEXT_PUBLIC_RPC_URL=https://<your-mainnet-soroban-rpc>   # primary; mainnet.sorobanrpc.com is the built-in fallback
# NEXT_PUBLIC_REGISTRY_ID=C...                             # deployments/registry-mainnet.json .registry
# NEXT_PUBLIC_VERIFIER_ID=C...                             # post-ceremony verifier
# NEXT_PUBLIC_HORIZON_URL=                                 # optional (default https://horizon.stellar.org)
# NEXT_PUBLIC_SAMPLE_CHEST_ID=1                            # chest the "open a chest" links point to on mainnet
# Network switch targets (defaults shown):
# NEXT_PUBLIC_TESTNET_URL=https://www.findloot.xyz
# NEXT_PUBLIC_MAINNET_URL=https://mainnet.findloot.xyz
# Mainnet beta caps enforced in /create (XLM): per claim and total per chest.
# NEXT_PUBLIC_MAX_PRIZE_PER_PLACE_XLM=1
# NEXT_PUBLIC_MAX_TOTAL_PRIZE_XLM=30

# --- Relayer limits (mainnet only) ---
# RELAYER_ACCOUNT=G...        # public key of the relayer; required for the balance check when using OZ Channels
# RELAYER_MIN_XLM=3           # stop sponsoring below this balance
# RELAY_MAX_REGISTRATIONS=60  # max sponsored passkey wallet deploys in total (counter in Blob)
# RELAY_MAX_FEE_STROOPS=      # max fee of the final tx; default mainnet 20000000 (2 XLM)
# RELAY_RATE_PER_IP_PER_MIN=10
# RELAY_RATE_GLOBAL_PER_MIN=120
# Mainnet OZ Channels needs RELAYER_BASE_URL (the testnet default is built in).
